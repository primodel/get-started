# Copy to `.env` and adjust. `docker compose` reads `.env` automatically.

# Port the Primodel UI/API is published on (http://localhost:<PRIMODEL_PORT>).
PRIMODEL_PORT=8080

# Container image. Pin a version tag for reproducible installs, e.g. ghcr.io/primodel/primodel:1.0.0
PRIMODEL_IMAGE=ghcr.io/primodel/primodel:latest

# ── Secrets — CHANGE THESE ──────────────────────────────────────────────────────────────────────
# Field-level encryption key. Generate a strong random value, e.g.:
#   openssl rand -base64 48
# Keep it stable: changing it makes previously-encrypted field values unreadable.
PRIMODEL_ENCRYPTION_KEY=

# Password for the auto-seeded initial "admin" user (first run only). If blank, a random password is
# generated and printed to the primodel container logs (`docker compose logs primodel`).
PRIMODEL_BOOTSTRAP_PASSWORD=

# ── TLS / HTTPS (optional) ──────────────────────────────────────────────────────────────────────
# Terminate TLS with a proxy in front. Set both, then run: docker compose --profile tls up -d
#   - PRIMODEL_TLS_OFFLOAD=true makes Primodel honour X-Forwarded-* and mark the auth cookie Secure.
#   - PRIMODEL_DOMAIN is the public DNS name; the bundled Caddy auto-provisions a Let's Encrypt cert.
# Leave these unset for local plain-HTTP on PRIMODEL_PORT. (For your own ingress/LB/API-Gateway,
# set PRIMODEL_TLS_OFFLOAD=true and skip the tls profile — see the TLS & HTTPS deployment docs.)
PRIMODEL_TLS_OFFLOAD=false
PRIMODEL_DOMAIN=

# ── Postgres ────────────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=primodel

# ── KEK / SoftHSM (field-level secret store, TASK-767) ─────────────────────────────────────────
# The `primodel` service's KEK backend is a real PKCS#11/Cryptoki token via the bundled SoftHSM
# init sidecar (see docker-compose.yml: softhsm-init) — not `PRIMODEL_KEK=none`, not raw key
# material in an env var. These two PINs authenticate to the LOCAL SoftHSM token itself; they are
# NOT the KEK/DEK key material (which never leaves the token). Fine to leave at the defaults for
# local eval — change them if you want a non-default demo PIN.
SOFTHSM_PIN=1234
SOFTHSM_SO_PIN=5678

# Two-phase startup, production only (not used by this local stack — PRIMODEL_DATABASE_URL above
# covers it): PRIMODEL_METADATA_SECRET_REF resolves the metadata DB credential from a secret store
# (AWS Secrets Manager / Azure Key Vault / Kubernetes Secret) at boot instead of a plain connection
# string, e.g. PRIMODEL_METADATA_SECRET_REF=aws:primodel/metadata-db. See the root README's
# "Configuration" section for the full precedence chain.
