# Primodel evaluation stack — Caddy front door.
#
# Default: plain HTTP on :8080 for local eval (no cert, no prompt).
# Set PRIMODEL_DOMAIN=your.domain.com in .env for automatic HTTPS (Let's Encrypt).
# Caddy automatically obtains and renews a certificate when a public domain is set;
# ensure ports 80 and 443 are reachable from the internet (HTTP-01 challenge).
# Add `email you@example.com` inside the global block for expiry notices.
#
# Routes (all same-origin — eliminates CORS for the GraphQL explorer):
#   /graphiql*        → GraphiQL explorer static files (vendored, served offline)
#   everything else   → primodel:8080 (UI, REST API, /graphql, /openapi, WebSocket subs)
{$PRIMODEL_SITE_ADDR::8080} {

    # ── GraphiQL explorer ─────────────────────────────────────────────────────
    # Fully vendored (React + GraphiQL UMD, offline-capable). index.html sets
    # <base href="/graphiql/"> so assets resolve after Caddy strips the prefix.
    handle_path /graphiql* {
        root * /srv/graphiql
        try_files {path} /index.html
        file_server
    }

    # ── Primodel (UI + REST + GraphQL + OpenAPI + WebSocket subscriptions) ────
    handle {
        reverse_proxy primodel:8080
    }
}
