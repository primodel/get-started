# Local runs of install.sh / install.ps1 drop a working dir + secrets here.
# Anchored to the repo root so it does NOT match helm/primodel/ (the chart).
/primodel/
.env
**/.env

# Bind-mounted runtime state (Postgres/NATS/object-store/Caddy) created next to the compose file.
/compose/data/

# OpenTofu / Terraform — local state, providers, and vars
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
crash.log
